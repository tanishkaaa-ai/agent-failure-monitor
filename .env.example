# ==========================================
# LLM Judge & Intervention Planner Configuration
# ==========================================
# Choose active provider: "grok", "gemini", "openai", or leave blank for offline mock
LLM_PROVIDER=grok

# ------------------------------------------
# 1. xAI Grok API Configuration
# Obtain your API key at: https://console.x.ai/
# ------------------------------------------
GROK_API_KEY=xai-your_grok_api_key_here
GROK_MODEL=grok-2-latest
# GROK_BASE_URL=https://api.x.ai/v1

# ------------------------------------------
# 2. Google Gemini API Configuration
# Obtain your API key at: https://aistudio.google.com/
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# 3. OpenAI / Local Model Configuration
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
